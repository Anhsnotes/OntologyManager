# description: Term has no rdfs:comment (plain-language definition). LLMs and people both need it.
# severity: error
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?term WHERE {
  VALUES ?type { owl:Class owl:ObjectProperty owl:DatatypeProperty }
  ?term a ?type .
  FILTER(isIRI(?term))
  FILTER NOT EXISTS { ?term rdfs:comment ?c }
}
